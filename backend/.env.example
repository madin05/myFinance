# MyFinance Backend - Environment Variables Example
# Copy file ini ke ".env" dan isi value-nya. JANGAN commit .env ke git.

# ─── DATABASE (PostgreSQL via Neon) ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── FIREBASE ADMIN ─────────────────────────────────────────────────────────
# File firebase-service-account.json harus ada di folder backend/ (juga di-gitignore)

# ─── GEMINI API (untuk fitur Scan Struk) ────────────────────────────────────
# Dapetin API key gratis di: https://aistudio.google.com/apikey
# Free tier: 15 request/menit, 1500 request/hari (cukup buat personal app)
GEMINI_API_KEY=""

# ─── SERVER CONFIG ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
