# MyFinance Backend - Environment Variables Example
# Copy file ini ke ".env" di folder backend/ dan isi nilainya.
# PERINGATAN: JANGAN PERNAH meng-commit file ".env" ke Git!

# ─── DATABASE (PostgreSQL / Neon) ──────────────────────────────────────────
# String koneksi database PostgreSQL (termasuk sslmode=require untuk Neon)
DATABASE_URL="postgresql://user:password@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── FIREBASE ADMIN ─────────────────────────────────────────────────────────
# Taruh file "firebase-service-account.json" di folder backend/ (ter-ignore di .gitignore)

# ─── JWT SECRET (Stateless 2FA Pre-Auth Tokens) ─────────────────────────────
# Kunci rahasia untuk menandatangani token JWT 2FA sementara (Pre-Auth JWT)
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# ─── EMAIL SMTP CONFIG (Gmail App Password) ───────────────────────────────
# Email pengirim notifikasi & OTP
GMAIL_USER="your_email@gmail.com"

# Password Aplikasi Google 16-karakter (Buat di: https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── GEMINI API (Scan Struk & AI Insights) ──────────────────────────────────
# Dapatkan API key di: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── SERVER CONFIG ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
