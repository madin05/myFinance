generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int              @id @default(autoincrement())
  firebaseUid       String           @unique
  name              String
  email             String           @unique
  password          String?
  avatar            String?
  currency          String           @default("IDR")
  financialStartDay Int              @default(1)
  balanceOffset     Float            @default(0)
  is2FAEnabled          Boolean          @default(false)
  twoFactorEmailEnabled Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  transactions      Transaction[]
  savings           Saving[]
  budgets           Budget[]
  accounts          Account[]
  twoFactorTokens   TwoFactorToken[]
  otpVerifications  OtpVerification[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  category    String
  method      String
  account     String?  // Nama akun spesifik: "DANA", "Gopay", "BCA", dll
  description String
  amount      Float
  type        String   // "income" | "expense"
  createdAt   DateTime @default(now())
}

model Saving {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  icon          String
  color         String
  orderIndex    Int      @default(0)
  isDone        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  period    String   // Format "2024-04"
  createdAt DateTime @default(now())

  @@unique([userId, category, period])
}

model Account {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String   // "Bank" | "E-Wallet" | "Cash"
  balance    Float    @default(0)
  logo       String   @default("")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TwoFactorToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  type      String   @default("LOGIN") // "LOGIN" | "SETUP"
  deviceIp  String
  userAgent String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
}

enum OtpType {
  REGISTRATION
  LOGIN_2FA
  ENABLE_2FA
  DISABLE_2FA
  PASSWORD_RESET
  TRANSACTION_APPROVAL
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  type      OtpType  @default(LOGIN_2FA)
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, type, isUsed])
}
